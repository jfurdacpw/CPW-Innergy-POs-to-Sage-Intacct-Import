# Innergy API key. Sent as the "Api-Key" header (raw value, no "Bearer"/prefix).
# Requires the Purchasing -> PurchaseOrder -> View permission.
INNERGY_API_KEY=

# Optional: override the Innergy API base URL (defaults to https://app.innergy.com).
# INNERGY_BASE_URL=https://app.innergy.com

# --- Sage Intacct REST API (the "Sage API (test)" tab) ---
# From the Sage App Registry entry for this app. The client_id must also be added
# under Company > Setup > Company > Security > Authorized Client Applications,
# paired with the Web Services user ID below (case-sensitive).
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Web Services user, formatted userId@companyId. The companyId is what selects the
# environment — the implementation/sandbox company is a different companyId, not a
# different base URL.
SAGE_WS_USER=

# Optional: scope every call to one sub-entity (sent as X-IA-API-Param-Entity),
# e.g. 20-PA. Leave blank for top-level access.
# SAGE_ENTITY_ID=

# Optional: override the Sage API base URL (defaults to https://api.intacct.com/ia/api/v1).
# SAGE_BASE_URL=https://api.intacct.com/ia/api/v1
