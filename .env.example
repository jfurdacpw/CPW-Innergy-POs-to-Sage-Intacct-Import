# Innergy API key. Sent as the "Api-Key" header (raw value, no "Bearer"/prefix).
# Requires the Purchasing -> PurchaseOrder -> View permission.
INNERGY_API_KEY=

# Optional: override the Innergy API base URL (defaults to https://app.innergy.com).
# INNERGY_BASE_URL=https://app.innergy.com

# --- Sage Intacct REST API (the "Sage API (test)" tab) ---
# Current setup: our registered app uses the user-facing authorization-code
# workflow, so paste an access token minted by hand (e.g. from the Sage Postman
# collection, logging in against ciderpresswoodworks-imp). Tokens live 12 hours —
# expect to re-paste. The browser login flow will replace this.
SAGE_ACCESS_TOKEN=

# The alternative auth mode: client credentials (server-to-server, no login). Used
# only when SAGE_ACCESS_TOKEN is blank, and needs a Web Services user, which does
# not exist yet. The client_id must also be listed under Company > Setup > Company
# > Security > Authorized Client Applications, paired with that user (case-sensitive).
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Web Services user for client credentials, formatted userId@companyId
# (e.g. someUser@ciderpresswoodworks-imp). The companyId selects the environment.
SAGE_WS_USER=

# Default sub-entity for calls that don't name one (10 / 20 / 30). The Sage tab can
# override it per request; blank means top level.
SAGE_ENTITY_ID=20

# Optional: override the Sage API base URL (defaults to https://api.intacct.com/ia/api/v1).
# SAGE_BASE_URL=https://api.intacct.com/ia/api/v1
