# --- Microsoft sign-in (Entra ID via Auth.js) ---
# The whole app is behind Microsoft login; access is limited to the addresses in
# lib/authAllowlist.ts. All four of these are required for login to work.
#
# Random 32-byte secret that signs the session cookie: openssl rand -base64 32
# Use the SAME value in every environment you want sessions to survive across.
AUTH_SECRET=

# From the Azure app registration (Overview page).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Tenant-specific issuer — this is what limits login to the CPW tenant. Using
# /common here would let ANY Microsoft account reach the allowlist check.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# Innergy API key. Sent as the "Api-Key" header (raw value, no "Bearer"/prefix).
# Requires the Purchasing -> PurchaseOrder -> View permission.
INNERGY_API_KEY=

# Optional: override the Innergy API base URL (defaults to https://app.innergy.com).
# INNERGY_BASE_URL=https://app.innergy.com

# --- Sage Intacct REST API ---
# From the Sage App Registry entry for this app.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Web Services user, formatted userId@companyId (e.g.
# someUser@ciderpresswoodworks-imp). The companyId selects the environment.
#
# THIS VALUE IS A MODE SWITCH. As soon as it contains an "@", the app mints its own
# tokens via client credentials and ignores SAGE_ACCESS_TOKEN below — which is how
# the 12-hourly re-pasting ends. A bare company id with no "@" is treated as "no WS
# user" (Sage rejects it: "The username format is invalid (expected user@company)").
#
# Do the Sage side FIRST or every Sage call breaks: create the user under Company >
# Admin > Web Services Users, give it a role that can CREATE AR invoices, and pair
# its user id with SAGE_CLIENT_ID under Company > Setup > Company > [Edit] >
# Security > Authorized Client Applications (case-sensitive).
SAGE_WS_USER=

# Fallback auth, used only while SAGE_WS_USER has no "@": an access token minted by
# hand (e.g. the Sage Postman collection, logging in against
# ciderpresswoodworks-imp). Tokens live 12 hours, so expect to re-paste this daily
# until the Web Services user above exists. Delete it afterwards.
SAGE_ACCESS_TOKEN=

# Default sub-entity for calls that don't name one (10 / 20 / 30). The Sage tab can
# override it per request; blank means top level.
SAGE_ENTITY_ID=20

# Optional: override the Sage API base URL (defaults to https://api.intacct.com/ia/api/v1).
# SAGE_BASE_URL=https://api.intacct.com/ia/api/v1
